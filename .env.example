# Copy to .env for local use. Never commit the real .env. Every variable below is read by apps/backend/src/config.js (plus the two build-time frontend ones at the end).

# --- Core ---
PORT=3000
# Interface to bind. 0.0.0.0 lets classmates on the LAN connect; use 127.0.0.1 for this computer only.
HOST=0.0.0.0
# Folder of the built React app. Default: apps/classroom-web/dist
STATIC_DIR=
NODE_ENV=development
# REQUIRED in production, >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=
# Login token lifetime in seconds (300 .. 604800). Default 8 hours.
JWT_TTL_SECONDS=28800
# MongoDB connection URI. Default: mongodb://localhost:27017/echoclass
MONGODB_URI=mongodb://localhost:27017/echoclass
# Public https URL of the site, and any extra browser origins allowed to call the API / open the WebSocket (comma separated).
PUBLIC_URL=
ALLOWED_ORIGINS=
# Reverse proxies in front of the app (production default 1). Needed for correct client IPs and rate limits.
TRUST_PROXY=
LOG_LEVEL=info

# --- Teacher accounts ---
# Required in production (>= 8 chars): people must enter this to register as a teacher. Students can self-register.
TEACHER_INVITE_CODE=
# Only set to true if you really want anyone to be able to register as a teacher.
ALLOW_OPEN_TEACHER_SIGNUP=false

# --- Data retention ---
# Default days to keep transcripts for new classrooms; 0 = keep until a teacher deletes them.
DEFAULT_RETENTION_DAYS=0

# --- Optional AI study notes (off unless AI_PROVIDER is set). Sends teacher captions to the provider after teacher consent. ---
AI_PROVIDER=none            # none | anthropic | openai (openai = any OpenAI-compatible /chat/completions API)
AI_API_KEY=
AI_MODEL=                   # required when enabled; pick a current model from your provider's docs
AI_BASE_URL=                # optional override
AI_MAX_INPUT_CHARS=24000
AI_TIMEOUT_MS=30000
AI_DAILY_LIMIT=200

# --- Optional server-side transcription API (off unless set). No recorder UI is wired in the frontend yet. ---
TRANSCRIPTION_PROVIDER=none # none | openai
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MAX_BYTES=2097152
TRANSCRIPTION_MAX_SECONDS=30
TRANSCRIPTION_TIMEOUT_MS=20000

# --- Optional offline speech (Vosk). Needs python3 + `pip install vosk` and a model in models/vosk (npm run fetch-speech-model). ---
VOSK_MODEL_PATH=
PYTHON_PATH=

# --- Optional HTTPS for LAN use (microphone/camera need HTTPS or localhost). npm run gen-cert creates a self-signed pair. ---
HTTPS_ENABLED=false
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# --- Frontends (build-time) ---
# React dev server only: where `npm run dev:classroom` proxies /api, /ws, /vendor
VITE_DEV_API_TARGET=http://localhost:3000
# Next.js public site: where the "Open classroom" buttons point
NEXT_PUBLIC_CLASSROOM_URL=http://localhost:3000
# Only if the API is on a different origin than the React app (leave empty for same-origin, the default):
VITE_API_BASE_URL=
VITE_WS_URL=
