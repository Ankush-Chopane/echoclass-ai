{
  "name": "@echoclass/backend",
  "version": "2.0.0",
  "description": "EchoClass AI Node.js Express & MongoDB Backend Service",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/backup.js",
    "docs:gestures": "node scripts/gen-gesture-docs.js",
    "eval:gestures": "node scripts/eval-gestures.js",
    "fetch-model": "node scripts/fetch-model.js",
    "fetch-speech-model": "node scripts/fetch-speech-model.js",
    "gen-cert": "node scripts/gen-cert.js",
    "preflight": "node scripts/preflight.js"
  },
  "dependencies": {
    "@echoclass/shared": "*",
    "@mediapipe/tasks-vision": "1.1.0",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "mongodb": "^6.21.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
